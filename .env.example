# URLs d'export iCal (Extranet Booking → Sync calendars → Export)
# Extranet Airbnb → Calendrier → Exporter le calendrier
BOOKING_ICAL_URL=
AIRBNB_ICAL_URL=

# Admin /admin — mot de passe de connexion
ADMIN_PASSWORD=

# Typeform — Personal token (scopes : forms:read, forms:write, responses:read)
# https://admin.typeform.com/account#/section/tokens
TYPEFORM_ACCESS_TOKEN=
# ID API (court) : URL admin.typeform.com/form/XXXX — pas l'ID Live 01… de l'embed
TYPEFORM_API_FORM_ID=
TYPEFORM_FORM_ID=
TYPEFORM_PARAM_CHECKIN=
TYPEFORM_PARAM_CHECKOUT=

# ─── Resend (production) ─────────────────────────────────────────────
# Token : scopes sending + contacts (+ segments si newsletter)
RESEND_API_KEY=

# Transactionnel : accept/refuse réservation (+ e-mail opt-in newsletter)
RESERVATION_FROM_EMAIL=Le Nid de la Sittelle <reservations@bnb-valais.ch>
# Marketing : optionnel pour Broadcasts dashboard (peut = reservations@)
NEWSLETTER_FROM_EMAIL=Le Nid de la Sittelle <newsletter@bnb-valais.ch>
HOST_CONTACT_EMAIL=info@bnb-valais.ch

# Templates accept/refuse : npm run setup:resend (met à jour Resend)
# RESEND_TEMPLATE_ACCEPT=bnb-valais-reservation-accept
# RESEND_TEMPLATE_REJECT=bnb-valais-reservation-decline
# RESEND_USE_TEMPLATES=true
# Broadcast test −10 % nov. 2026 : npm run resend:sync-promo-nov2026
# RESEND_PROMO_NOV2026_TEMPLATE=bnb-valais-promo-nov2026-test

# Coordonnées bancaires (e-mail d’acceptation)
RESERVATION_BANK_ACCOUNT_HOLDER=Damien Balet et Canan Özcan
RESERVATION_IBAN=CH46 8080 8002 6049 0052 0
RESERVATION_BIC=RAIFCH22

# ─── Vercel Blob (bnb-valais-blob) ───────────────────────────────────
# Calendrier orange + décisions admin + pending newsletter
# BLOB_READ_WRITE_TOKEN=   (auto si store connecté)
# BLOB_STORE_ID=

# ─── Site & newsletter (double opt-in pied de page) ─────────────────
NEXT_PUBLIC_SITE_URL=https://www.bnb-valais.ch
# Créés par : RESEND_API_KEY=… npm run setup:resend
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=

# ─── Setup one-shot (local, avec RESEND_API_KEY) ─────────────────────
# npm run setup:resend          → segment + topic + templates Resend
# npm run setup:vercel-checklist → aide variables Vercel
# vercel login && vercel link   → puis coller les IDs sur Vercel → Redeploy
