# URLs d'export iCal (Extranet Booking → Sync calendars → Export)
# Extranet Airbnb → Calendrier → Exporter le calendrier
BOOKING_ICAL_URL=
AIRBNB_ICAL_URL=

# Admin /admin — mot de passe de connexion
ADMIN_PASSWORD=

# Typeform — Personal token : https://admin.typeform.com/account#/section/tokens
# Form ID (défaut : formulaire du site)
TYPEFORM_ACCESS_TOKEN=
TYPEFORM_FORM_ID=01JN38VBCPQKPJFGQK77ZR4JDG

# Envoi e-mail automatique (optionnel) — https://resend.com
# Sans Resend, accepter/refuser ouvre votre messagerie (mailto)
RESEND_API_KEY=
RESERVATION_FROM_EMAIL=Le Nid de la Sittelle <reservations@bnb-valais.ch>
HOST_CONTACT_EMAIL=
