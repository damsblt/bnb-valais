# URLs d'export iCal (Extranet Booking → Sync calendars → Export)
# Extranet Airbnb → Calendrier → Exporter le calendrier
BOOKING_ICAL_URL=
AIRBNB_ICAL_URL=

# Admin /admin — mot de passe de connexion
ADMIN_PASSWORD=

# Typeform — Personal token (scopes : forms:read, forms:write, responses:read)
# https://admin.typeform.com/account#/section/tokens
TYPEFORM_ACCESS_TOKEN=
# ID API (court) : URL admin.typeform.com/form/XXXX — pas l'ID Live 01… de l'embed
TYPEFORM_API_FORM_ID=
# Ancien nom (ignoré si c'est un ID Live 01…)
TYPEFORM_FORM_ID=
# Optionnel : forcer les clés de préremplissage (sinon détection auto via API :
# refs « Date d'arrivée » / « Date de départ » dans Block references)
TYPEFORM_PARAM_CHECKIN=
TYPEFORM_PARAM_CHECKOUT=

# Envoi e-mail automatique (optionnel) — https://resend.com
# Sur Vercel : cocher Production + Development, puis Redeploy.
# Vérifier le domaine bnb-valais.ch dans Resend (DNS) avant d'utiliser reservations@…
# Sans RESEND_API_KEY, accepter/refuser ouvre votre messagerie (mailto).
RESEND_API_KEY=
RESERVATION_FROM_EMAIL=Le Nid de la Sittelle <reservations@bnb-valais.ch>
HOST_CONTACT_EMAIL=
# Templates Resend (optionnel) — créer avec : npm run resend:sync-templates
# Par défaut : alias bnb-valais-reservation-accept / bnb-valais-reservation-decline
# RESEND_TEMPLATE_ACCEPT=
# RESEND_TEMPLATE_REJECT=
# Mettre false pour n'envoyer que le HTML inline (sans template dashboard)
# RESEND_USE_TEMPLATES=true

# Calendrier orange (séjours acceptés via /admin)
# Vercel → Storage → store « bnb-valais-blob » → Connect to Project (Production)
# Variables injectées automatiquement :
#   BLOB_READ_WRITE_TOKEN  (obligatoire pour lire/écrire)
#   BLOB_STORE_ID          (optionnel ; utile si plusieurs Blob stores)
# Après connexion du store : Redeploy obligatoire.
# Vérification : GET /api/availability → acceptedStorageConfigured: true
